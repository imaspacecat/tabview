{
  "name": "tabview",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "build": "npm run check && vite build && node scripts/build-background.mjs",
    "lint:extension": "addons-linter dist --warnings-as-errors",
    "package:zip": "node scripts/package.mjs",
    "package": "npm run build && npm run package:zip"
  },
  "dependencies": {
    "@nozbe/microfuzz": "^1.0.0"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "addons-linter": "^10.13.0",
    "fflate": "^0.8.3",
    "jsdom": "^27.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
