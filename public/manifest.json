{
  "manifest_version": 3,
  "name": "Tabview",
  "version": "0.1.0",
  "description": "Search, organize, and close tabs in a minimal dashboard with local recovery.",
  "permissions": ["tabs", "storage", "sessions"],
  "optional_permissions": ["cookies"],
  "incognito": "not_allowed",
  "background": { "scripts": ["background.js"] },
  "action": { "default_title": "Open Tabview", "default_icon": "icon.svg" },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "commands": {
    "open-dashboard": {
      "suggested_key": { "default": "Ctrl+Alt+Y" },
      "description": "Open Tabview"
    }
  },
  "browser_specific_settings": {
    "gecko_android": { "strict_min_version": "142.0" },
    "gecko": {
      "id": "tabview@spacecat.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
